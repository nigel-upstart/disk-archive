# Rust core configuration; see crates/core/README.md for syntax and limits.
# Copy to a local .env. Never commit real values or credentials.
# Required, deliberately empty: no identifying destination defaults.
DISK_ARCHIVE_BUCKET=
DISK_ARCHIVE_PREFIX=

# Optional settings are omitted rather than assigned empty/invalid values.
# Paths have no personal defaults. Root lists use semicolons, relative to cwd.
# DISK_ARCHIVE_WORK_DIR=<work-directory>
# DISK_ARCHIVE_ROOTS_ALL_FILES=<source-directory>;<another-source-directory>
# DISK_ARCHIVE_ROOTS_JSONL=<jsonl-source-directory>
# DISK_ARCHIVE_AWS_PROFILE=<profile>
# DISK_ARCHIVE_REGION=<region>
# DISK_ARCHIVE_MIN_AGE_DAYS=30
# DISK_ARCHIVE_WORKERS=4
# Env-file lookup: --env-file, then $XDG_CONFIG_HOME/disk-archive/.env, then ./.env.
# Process DISK_ARCHIVE_* values override the selected file. No interpolation.
# Keep credentials in the normal AWS credential chain, not in this example.
